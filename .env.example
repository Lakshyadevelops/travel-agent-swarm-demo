# Copy to .env and fill in. .env is gitignored.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alternative to an API key: Vertex AI through Application Default Credentials
# (what the Cloud Run deployment uses; see deploy/). Leave GOOGLE_API_KEY empty
# when you turn this on. Gemini 3.x publisher models are served from "global".
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=ks-opm-project
# GOOGLE_CLOUD_LOCATION=global

# Fallback model for code that doesn't choose one. The UI always uses live
# Gemini, and the benchmark scripts always use the deterministic fake model.
# "fake"   -> deterministic FakeLlm: model latency is ~0 so storage differences
#             are actually measurable.
# "gemini" -> real Gemini calls.
LLM_MODE=fake

# The compose file publishes the stores on 127.0.0.1 only.
VALKEY_URL=redis://127.0.0.1:6379
# Cache tier for the postgres_cached benchmark arm only. "off" disables it
# (the hosted deployment has no second Valkey; the UI never offers that arm).
VALKEY_CACHE_URL=redis://127.0.0.1:6380
# Local development credential. If you change it, also set POSTGRES_PASSWORD
# before the Postgres container is first created.
POSTGRES_DSN=postgresql://swarm:swarm@127.0.0.1:5432/swarm

# Cloud Run's PORT takes precedence when set.
APP_PORT=8080
# Where per-run telemetry (runs/<run_id>/ops.jsonl) is written. Default: ./runs
# RUNS_DIR=/tmp/runs

# Simulated latency for the mock travel providers, in ms.
# Demo realism wants ~40ms; the benchmark zeroes it so synthetic sleeps don't
# swamp the signal we are trying to measure.
PROVIDER_LATENCY_MS=40
PROVIDER_LATENCY_MS_BENCH=0

# Scratchpad writes per agent step -- the primary benchmark sweep axis.
SCRATCHPAD_WRITES_PER_STEP=1
SCRATCHPAD_TTL_SECONDS=900
