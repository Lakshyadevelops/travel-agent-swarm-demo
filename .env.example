# Copy to .env and fill in. .env is gitignored.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# "fake"   -> deterministic FakeLlm. Use for benchmarking: model latency is ~0 so
#             storage differences are actually measurable.
# "gemini" -> real Gemini calls. Use for the demo.
LLM_MODE=fake

VALKEY_URL=redis://localhost:6379
VALKEY_CACHE_URL=redis://localhost:6380
POSTGRES_DSN=postgresql://swarm:swarm@localhost:5432/swarm

APP_PORT=8080

# Simulated latency for the mock travel providers, in ms.
# Demo realism wants ~40ms; the benchmark zeroes it so synthetic sleeps don't
# swamp the signal we are trying to measure.
PROVIDER_LATENCY_MS=40
PROVIDER_LATENCY_MS_BENCH=0

# Scratchpad writes per agent step -- the primary benchmark sweep axis.
SCRATCHPAD_WRITES_PER_STEP=1
SCRATCHPAD_TTL_SECONDS=900
